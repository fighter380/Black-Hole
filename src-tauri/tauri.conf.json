{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Second Brain Black Hole",
  "version": "0.2.2",
  "identifier": "com.sbbh.codelab",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Second Brain Black Hole — Code Lab",
        "width": 1380,
        "height": 860,
        "backgroundColor": "#030303",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": { "pubkey": "", "requireSignedVersion": true }
  },
  "bundle": {
  "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "languages": ["French", "English"],
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      }
    },
  "icon": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ]
}
}
