{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Second Brain Black Hole",
  "version": "0.2.5",
  "identifier": "com.sbbh.codelab",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "create": false,
        "title": "Second Brain Black Hole — Code Lab",
        "width": 1380,
        "height": 860,
        "backgroundColor": "#030303",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyRDU0NTlGMjYzREQxQkEKUldTNjBUMG1uMFhWVWozN2EvV08vR1N0bHg2aSszMnhFTGE1TTZRa0pvditlVFR4OHQvRFBUVGMK",
      "endpoints": ["https://github.com/fighter380/Blak-Hole/releases/download/rolling/latest.json"],
      "windows": { "installMode": "quiet" },
      "requireSignedVersion": true
    }
  },
  "bundle": {
  "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "installerHooks": "installer/open-with.nsh",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      }
    },
  "icon": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ]
}
}
